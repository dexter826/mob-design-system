    "--mob-signal-chart-dash-3": "4px 4px",
    "--mob-signal-sparkline-height": "24px",
    "--mob-signal-chart-y-ticks": "4",
    "--mob-signal-control-border": "{color.control-border}",
    "--mob-signal-error-text": "{color.error-text}"
  }
}
