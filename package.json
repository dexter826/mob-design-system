{
  "name": "mob-signal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A dark, square UI system for engineering consoles, built around dense data, operational states, and one disciplined green signal.",
  "exports": {
    ".": "./dist/colors_and_type.css",
    "./components.css": "./dist/components.css",
    "./overlays.css": "./dist/overlays.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens/*": "./dist/tokens/*",
    "./ui/*": "./registry/default/ui/*"
  },
  "scripts": {
    "start": "node scripts/server.mjs",
    "preview": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "contrast": "node scripts/contrast.mjs",
    "design-md": "node scripts/design-md-from-brand.mjs",
    "sync:engine": "node scripts/build.mjs",
    "check:tokens": "node scripts/token-check.mjs",
    "lint:design": "designmd lint DESIGN.md",
    "test:tokens": "node scripts/token-check.mjs",
    "test:build": "node --test tests/package.test.mjs",
    "test": "npm run test:tokens && npm run test:build && npm run lint:design"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.25.12"
  }
}
